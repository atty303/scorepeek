amends "package://github.com/jdx/hk/releases/download/v1.54.1/hk@1.54.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.54.1/hk@1.54.1#/Builtins.pkl"

min_hk_version = "1.54.1"

local linters = new Mapping<String, Step> {
  ["actionlint"] = (Builtins.actionlint) {
    check { argv = List("actionlint", "-shellcheck=", "{{files}}") }
  }
  ["case-conflict"] = Builtins.check_case_conflict
  ["merge-conflict"] = Builtins.check_merge_conflict
  ["mise"] = Builtins.mise
  ["private-key"] = Builtins.detect_private_key
  ["rust:cargo_fmt"] {
    workspace_indicator = "Cargo.toml"
    glob = List("*.rs")
    stage = glob
    prefix = "mise exec --"
    check = "rustfmt --edition 2024 --check {{files}}"
    fix = "rustfmt --edition 2024 {{files}}"
    check_first = false
    env {
      ["CARGO_TERM_PROGRESS_WHEN"] = "never"
    }
  }
  ["taplo"] = Builtins.taplo
}

hooks {
  ["pre-commit"] { fix = true; stash = "git"; steps = linters }
  ["check"] { steps = linters }
  ["fix"] { fix = true; steps = linters }
}
